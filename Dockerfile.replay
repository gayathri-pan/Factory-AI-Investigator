FROM python:3.12-slim-bookworm
ENV PYTHONUNBUFFERED=1 PYTHONDONTWRITEBYTECODE=1 PYTHONPATH=/app/src
WORKDIR /app

RUN apt-get update \
    && apt-get install -y --no-install-recommends libgomp1 \
    && rm -rf /var/lib/apt/lists/*

COPY requirements-replay.txt ./
RUN pip install --no-cache-dir -r requirements-replay.txt && pip check

COPY src/anomaly_detection/ ./src/anomaly_detection/
COPY scripts/ ./scripts/

RUN python -c "import sys; sys.path.insert(0, '/app/scripts'); import run_cloud_replay"

CMD ["python", "/app/scripts/run_cloud_replay.py"]