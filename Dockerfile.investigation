FROM python:3.12-slim-bookworm
ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PIP_NO_CACHE_DIR=1 \
    PYTHONPATH=/app/src \
    TOKENIZERS_PARALLELISM=false \
    OMP_NUM_THREADS=2
WORKDIR /app
RUN apt-get update \
    && apt-get install -y --no-install-recommends libgomp1 \
    && rm -rf /var/lib/apt/lists/*
COPY requirements-investigation.txt ./
RUN pip install --no-cache-dir torch==2.14.0 --index-url https://download.pytorch.org/whl/cpu
RUN pip install --no-cache-dir -r requirements-investigation.txt && pip check
COPY src/investigation/ ./src/investigation/
COPY src/rag/ ./src/rag/
RUN python -c "import torch; assert torch.version.cuda is None; import investigation.worker_api; print('Worker imports: PASS')"
RUN python -c "import inspect; from investigation.report_store import InvestigationReportStore; inspect.signature(InvestigationReportStore.save_completed).bind(None, package={}, report='check', model_name='check', investigation_id='inv_check'); assert hasattr(InvestigationReportStore, '_check_identity'); print('Report-store interface: PASS')"
CMD ["sh", "-c", "exec python -m uvicorn investigation.worker_api:app --host 0.0.0.0 --port ${PORT:-8080} --workers 1"]
