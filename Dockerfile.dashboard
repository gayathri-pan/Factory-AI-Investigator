FROM python:3.12-slim-bookworm
ENV PYTHONUNBUFFERED=1 PYTHONDONTWRITEBYTECODE=1
WORKDIR /app
COPY requirements-dashboard.txt ./
RUN pip install --no-cache-dir -r requirements-dashboard.txt && pip check
COPY src/dashboard_api.py ./
RUN python -m py_compile dashboard_api.py
CMD ["sh", "-c", "exec python -m uvicorn dashboard_api:app --host 0.0.0.0 --port ${PORT:-8080}"]
